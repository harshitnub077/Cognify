{
  "manifest_version": 3,
  "name": "Cognify",
  "version": "1.0.0",
  "description": "Conscious content intelligence for YouTube",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.instagram.com/*",
    "http://localhost:8001/*",
    "https://cognify-api-lin2.onrender.com/*",
    "http://localhost:5173/*",
    "http://localhost:5174/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content/youtube.js"],
      "css": ["content/injected-badge.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.instagram.com/*"],
      "js": ["content/instagram.js"],
      "css": ["content/injected-badge.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://localhost:5173/*", "http://localhost:5174/*"],
      "js": ["content/sync-auth.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Cognify",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
